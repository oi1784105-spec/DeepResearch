LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL=your-model-id
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SECRET_KEY=change-this-in-production
API_KEY_ENCRYPTION_KEY=
AUTH_DB_PATH=./data/app.db
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant
MAX_ITERATIONS=3
ENABLE_MEMORY=false
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=memory
LONG_TERM_BACKEND=disabled
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false
CHECKPOINTER_BACKEND=memory
ENABLE_MILVUS=false
MEMORY_TOP_K=6
REDIS_URL=
POSTGRES_DSN=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory
NO_COLOR=
WORKSPACE_DIR=.

# Optional cloud TTS. Keep browser fallback by leaving TTS_PROVIDER=browser.
# Recommended: ElevenLabs for multilingual natural voice, Fish Audio for Chinese voices.
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL=eleven_multilingual_v2
TTS_BASE_URL=
TTS_STABILITY=0.52
TTS_SIMILARITY=0.82
TTS_STYLE=0.12
TTS_CONNECT_TIMEOUT=8
TTS_READ_TIMEOUT=45
